# freellm API keys. Copy to .env (git-ignored) and fill in what you have.
# Every key is optional; OVH and LLM7 work with no key at all.
# Several keys for one provider: FOO_API_KEY=a  FOO_API_KEY_2=b  (or FOO_API_KEY=a,b)
# Steps for each: `uv run freellm keys --steps`

# OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Mistral AI (Experiment plan) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# NVIDIA NIM (build.nvidia.com) — https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# OVHcloud AI Endpoints — https://www.ovhcloud.com/en/public-cloud/ai-endpoints/catalog/ (optional, works keyless)
OVH_AI_ENDPOINTS_ACCESS_TOKEN=

# LLM7.io — https://token.llm7.io (optional, works keyless)
LLM7_API_KEY=

# Cohere (trial key) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# SambaNova Cloud — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
HF_TOKEN=

# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenCode Zen (free models) — https://opencode.ai/auth
OPENCODE_API_KEY=

# Kilo Code gateway (free models) — https://app.kilo.ai/profile
KILO_API_KEY=

# Z.ai (GLM flash models) — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=
