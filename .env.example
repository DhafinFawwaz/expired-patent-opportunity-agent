# Copy to .env. Only GOOGLE_CLOUD_PROJECT is needed for a live run; --replay and demo need nothing.
# Free LLM provider keys live in llm/.env (see llm/.env.example).

# Google Cloud project with BigQuery enabled (sandbox mode is fine)
GOOGLE_CLOUD_PROJECT=
# Optional: run BigQuery as this gcloud account instead of Application Default Credentials
GOOGLE_CLOUD_ACCOUNT=

# EPO Open Patent Services, optional cross-check for legal status
EPO_OPS_KEY=
EPO_OPS_SECRET=

# USPTO Open Data Portal key, optional and not used live (needs ID.me verification)
USPTO_ODP_API_KEY=

# Any LiteLLM model string, overrides the free router (for example a paid model on demo day)
LLM_MODEL=


PATENTIC_CACHE_DIR=.cache
PATENTIC_OUTPUTS_DIR=outputs
